{
    "cookiebot": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[id*='CybotCookiebot'], #CybotCookiebotDialogBodyLevelButtonPreferencesInline"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[id*='CybotCookiebot'], #CybotCookiebotDialogBodyLevelButtonPreferencesInline",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CybotCookiebotDialogBodyLevelB",
                        "displayFilter": true
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonPreferencesInline"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonPreferencesInline"
                                }
                            },
                            "type": "A"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonStatisticsInline"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonStatisticsInline"
                                }
                            },
                            "type": "B"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonMarketingInline"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonMarketingInline"
                                }
                            },
                            "type": "F"
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection",
                        "displayFilter": true
                    }
                }
            },
            {
            "name": "HIDE_CMP",
            "action": {
                "type": "hide",
                "target": {
                    "selector": "[id*='CybotCookiebot']"
                }
            }
            }
        ]
    }
}
