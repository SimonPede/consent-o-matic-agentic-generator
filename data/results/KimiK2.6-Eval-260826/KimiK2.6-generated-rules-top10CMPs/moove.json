{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Moove": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_info_bar"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_info_bar:not(.moove-gdpr-info-bar-hidden)"
              }
            }
          ]
        },
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_modal"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_modal:not(.gdpr_lightbox-hide)"
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "hide",
                "target": {
                  "selector": "#moove_gdpr_cookie_info_bar"
                }
              },
              {
                "type": "hide",
                "target": {
                  "selector": "#moove_gdpr_cookie_modal"
                }
              }
            ]
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": ".moove-gdpr-infobar-settings-btn"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "wait",
                "waitTime": 500
              },
              {
                "type": "consent",
                "consents": [
                  {
                    "type": "D",
                    "matcher": {
                      "type": "checkbox",
                      "target": {
                        "selector": "#moove_gdpr_strict_cookies"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "target": {
                        "selector": "#moove_gdpr_strict_cookies"
                      }
                    }
                  },
                  {
                    "type": "B",
                    "matcher": {
                      "type": "checkbox",
                      "target": {
                        "selector": "#moove_gdpr_performance_cookies"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "target": {
                        "selector": "#moove_gdpr_performance_cookies"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": ".moove-gdpr-modal-save-settings"
            }
          }
        }
      ]
    }
}