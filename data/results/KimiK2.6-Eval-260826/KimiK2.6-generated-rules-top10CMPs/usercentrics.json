{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Usercentrics": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#usercentrics-cmp-ui"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "parent": {
                "selector": "#usercentrics-cmp-ui"
              },
              "target": {
                "selector": "#uc-main-dialog",
                "displayFilter": true
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "#usercentrics-cmp-ui"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "A",
                "matcher": {
                  "type": "css",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-functional-toggle[aria-checked='true']"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-functional-toggle",
                    "displayFilter": true
                  }
                }
              },
              {
                "type": "F",
                "matcher": {
                  "type": "css",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-marketing-toggle[aria-checked='true']"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-marketing-toggle",
                    "displayFilter": true
                  }
                }
              },
              {
                "type": "B",
                "matcher": {
                  "type": "css",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-customcategory-be421ec6-1e02-4b3d-b522-c6a3744bd356-toggle[aria-checked='true']"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "parent": {
                    "selector": "#usercentrics-cmp-ui"
                  },
                  "target": {
                    "selector": "#uc-category-customcategory-be421ec6-1e02-4b3d-b522-c6a3744bd356-toggle",
                    "displayFilter": true
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "wait",
                "waitTime": 300
              },
              {
                "type": "click",
                "parent": {
                  "selector": "#usercentrics-cmp-ui"
                },
                "target": {
                  "selector": "#save",
                  "displayFilter": true
                }
              }
            ]
          }
        }
      ]
    }
}