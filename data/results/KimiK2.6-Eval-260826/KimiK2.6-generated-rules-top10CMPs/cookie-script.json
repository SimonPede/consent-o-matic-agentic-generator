{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Cookie-Script": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "[id^='cookiescript_']"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#cookiescript_reject",
                "displayFilter": true
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": "#cookiescript_reject"
            }
          }
        }
      ]
    }
}