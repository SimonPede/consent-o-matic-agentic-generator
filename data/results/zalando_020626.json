{
    "Usercentrics": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#usercentrics-root"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#usercentrics-root"
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "parent": {
                        "selector": "#usercentrics-root"
                    },
                    "target": {
                        "selector": "[data-testid='uc-more-button']"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "B",
                            "matcher": {
                                "type": "css",
                                "parent": {
                                    "selector": "#usercentrics-root"
                                },
                                "target": {
                                    "selector": "[id^='toggle-toggle-custom-category'][aria-checked='true']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "parent": {
                                    "selector": "#usercentrics-root"
                                },
                                "target": {
                                    "selector": "[id^='toggle-toggle-custom-category']"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "matcher": {
                                "type": "css",
                                "parent": {
                                    "selector": "#usercentrics-root"
                                },
                                "target": {
                                    "selector": "#toggle-toggle-marketing[aria-checked='true']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "parent": {
                                    "selector": "#usercentrics-root"
                                },
                                "target": {
                                    "selector": "#toggle-toggle-marketing"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "wait",
                            "waitTime": 500
                        },
                        {
                            "type": "click",
                            "parent": {
                                "selector": "#usercentrics-root"
                            },
                            "target": {
                                "selector": "[data-testid='uc-save-button']"
                            }
                        }
                    ]
                }
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#usercentrics-root"
                    }
                }
            }
        ]
    }
}
