{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Moove": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_info_bar, #moove_gdpr_cookie_modal"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#moove_gdpr_cookie_info_bar:not(.moove-gdpr-info-bar-hidden), #moove_gdpr_cookie_modal:not(.gdpr_lightbox-hide)"
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "#moove_gdpr_cookie_info_bar"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": ".moove-gdpr-infobar-settings-btn, #moove_gdpr_save_popup_settings_button"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "D",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#moove_gdpr_strict_cookies"
                  }
                },
                "toggleAction": {
                  "type": "list",
                  "actions": [
                    {
                      "type": "click",
                      "target": {
                        "selector": "[data-href=\"#strict-necessary-cookies\"].moove-gdpr-tab-nav"
                      }
                    },
                    {
                      "type": "click",
                      "target": {
                        "selector": "#moove_gdpr_strict_cookies"
                      }
                    }
                  ]
                }
              },
              {
                "type": "B",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#moove_gdpr_performance_cookies"
                  }
                },
                "toggleAction": {
                  "type": "list",
                  "actions": [
                    {
                      "type": "click",
                      "target": {
                        "selector": "[data-href=\"#third_party_cookies\"].moove-gdpr-tab-nav"
                      }
                    },
                    {
                      "type": "click",
                      "target": {
                        "selector": "#moove_gdpr_performance_cookies"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": "[aria-label=\"Save Changes\"]"
            }
          }
        }
      ]
    }
}