{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	    "Didomi": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#didomi-host"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "body.didomi-popup-open"
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": "#didomi-notice-learn-more-button"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "D",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Storing and/or accessing information on a terminal"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Storing and/or accessing information on a terminal"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "F",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Personalised advertising and ad performance measurement"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Personalised advertising and ad performance measurement"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "E",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Personalised content, content performance measurement, audience data, and product development"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-category",
                    "childFilter": {
                      "target": {
                        "selector": ".didomi-consent-popup-category__name",
                        "textFilter": "Personalised content, content performance measurement, audience data, and product development"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "B",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Analytics"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Analytics"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "X",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Actively scan device characteristics for identification"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Actively scan device characteristics for identification"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "F",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Storage and access to geolocation information for targeted advertising purposes"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Storage and access to geolocation information for targeted advertising purposes"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              },
              {
                "type": "F",
                "trueAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Marketing"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Agree"
                  }
                },
                "falseAction": {
                  "type": "click",
                  "parent": {
                    "selector": ".didomi-consent-popup-data-processing",
                    "childFilter": {
                      "target": {
                        "selector": ".label-click",
                        "textFilter": "Marketing"
                      }
                    }
                  },
                  "target": {
                    "selector": "button",
                    "textFilter": "Disagree"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "wait",
                "waitTime": 500
              },
              {
                "type": "click",
                "target": {
                  "selector": "#btn-toggle-save"
                }
              }
            ]
          }
        }
      ]
    }
}