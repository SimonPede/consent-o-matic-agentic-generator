{
    "Transavia": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".CookieBanner-module__bannerOverlay--HQ6K2, #transavia-consent-banner"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".CookieBanner-module__bannerOverlay--HQ6K2, #transavia-consent-banner",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "[data-testid='button-set-preferences']"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "B",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cb-check-c"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#cb-check-c"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cb-check-d"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#cb-check-d"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "wait",
                            "waitTime": 500
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "[data-testid='button-save-preferences']"
                            }
                        }
                    ]
                }
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#transavia-consent-banner, .CookieBanner-module__bannerOverlay--HQ6K2"
                    }
                }
            }
        ]
    }
}
