{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "OneTrust": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#onetrust-banner-sdk"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#onetrust-banner-sdk"
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "#onetrust-consent-sdk"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": "#onetrust-pc-btn-handler"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "A",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#ot-group-id-3"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#ot-group-id-3"
                  }
                }
              },
              {
                "type": "B",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#ot-group-id-2"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#ot-group-id-2"
                  }
                }
              },
              {
                "type": "F",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#ot-group-id-4"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#ot-group-id-4"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": ".save-preference-btn-handler"
            }
          }
        }
      ]
    }
}