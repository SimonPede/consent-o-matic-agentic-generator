{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "TermsFeed": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#termsfeed-pc1-notice-banner"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": "#termsfeed_privacy_consent_banner_button_accept_all",
                "displayFilter": true
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "#termsfeed-pc1-notice-banner"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": "#termsfeed_privacy_consent_notice_banner_open_privacy_preferences"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "waitcss",
                "target": {
                  "selector": "#termsfeed-pc1-preferences-center",
                  "displayFilter": true
                },
                "retries": 10,
                "waitTime": 250
              },
              {
                "type": "consent",
                "consents": [
                  {
                    "type": "A",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "#functionality"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "label[for='functionality']"
                      }
                    }
                  },
                  {
                    "type": "B",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "#analytics"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "label[for='analytics']"
                      }
                    }
                  },
                  {
                    "type": "F",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "#advertising"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "label[for='advertising']"
                      }
                    }
                  },
                  {
                    "type": "F",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "#marketing"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "label[for='marketing']"
                      }
                    }
                  },
                  {
                    "type": "F",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed_pc1_preferences_center_vendors_category_marketing"
                      },
                      "target": {
                        "selector": ".termsfeed-pc1-preferences-center-content-vendors-item-toggler input.custom-toggle-input-tag"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed_pc1_preferences_center_vendors_category_marketing"
                      },
                      "target": {
                        "selector": ".termsfeed-pc1-preferences-center-content-vendors-item-toggler label"
                      }
                    }
                  },
                  {
                    "type": "X",
                    "matcher": {
                      "type": "checkbox",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "#tf-pc-auto-dnsmpi"
                      }
                    },
                    "toggleAction": {
                      "type": "click",
                      "parent": {
                        "selector": "#termsfeed-pc1-preferences-center"
                      },
                      "target": {
                        "selector": "label[for='tf-pc-auto-dnsmpi']"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "wait",
                "waitTime": 500
              },
              {
                "type": "click",
                "target": {
                  "selector": "#termsfeed-pc1-preferences-center-save-selection-button"
                }
              }
            ]
          }
        }
      ]
    }
}