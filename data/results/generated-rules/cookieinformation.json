{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "Cookie Information": {
      "detectors": [
        {
          "presentMatcher": {
            "type": "css",
            "target": {
              "selector": "#coi-banner-wrapper"
            }
          },
          "showingMatcher": {
            "type": "css",
            "target": {
              "selector": "#coi-banner-wrapper",
              "displayFilter": true
            }
          }
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "[id^=\"coi\"]"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "click",
            "target": {
              "selector": "#show_details"
            }
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "A",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#cookie_cat_functional"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#cookie_cat_functional"
                  }
                }
              },
              {
                "type": "B",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#cookie_cat_statistic"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#cookie_cat_statistic"
                  }
                }
              },
              {
                "type": "F",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": "#cookie_cat_marketing"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": "#cookie_cat_marketing"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": "#declineButton"
            }
          }
        }
      ]
    }
}