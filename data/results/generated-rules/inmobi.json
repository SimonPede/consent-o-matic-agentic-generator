{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "InMobi": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": ".accept-cookie"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": ".accept-cookie",
                "displayFilter": true
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": ".accept-cookie"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "click",
                "target": {
                  "parent": {
                    "selector": ".button-continer"
                  },
                  "selector": "button:nth-child(2)"
                }
              },
              {
                "type": "wait",
                "waitTime": 300
              }
            ]
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "F",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": ".customize-cookie-popup input[type=\"checkbox\"][value=\"adv\"]"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": ".customize-cookie-popup input[type=\"checkbox\"][value=\"adv\"]"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": ".customize-cookie-popup button:last-child"
            }
          }
        }
      ]
  }
}