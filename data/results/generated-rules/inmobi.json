{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "InMobi": {
      "detectors": [
        {
          "presentMatcher": [
            {
              "type": "css",
              "target": {
                "selector": ".accept-cookie"
              }
            }
          ],
          "showingMatcher": [
            {
              "type": "css",
              "target": {
                "selector": ".accept-cookie",
                "displayFilter": true
              }
            }
          ]
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": ".accept-cookie"
            }
          }
        },
        {
          "name": "OPEN_OPTIONS",
          "action": {
            "type": "list",
            "actions": [
              {
                "type": "click",
                "target": {
                  "selector": ".accept-cookie button",
                  "textFilter": [
                    "Customize",
                    "CUSTOMIZE"
                  ]
                }
              },
              {
                "type": "waitcss",
                "target": {
                  "selector": ".customize-cookie-popup"
                },
                "retries": 10,
                "waitTime": 250
              }
            ]
          }
        },
        {
          "name": "DO_CONSENT",
          "action": {
            "type": "consent",
            "consents": [
              {
                "type": "F",
                "matcher": {
                  "type": "checkbox",
                  "target": {
                    "selector": ".customize-cookie-popup input[value='adv']"
                  }
                },
                "toggleAction": {
                  "type": "click",
                  "target": {
                    "selector": ".customize-cookie-popup input[value='adv']"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": ".customize-cookie-popup button",
              "textFilter": [
                "Confirm",
                "CONFIRM"
              ]
            }
          }
        }
      ]
    }
}