{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
      "Cookie-Script": {
      "detectors": [
        {
          "presentMatcher": {
            "type": "css",
            "target": {
              "selector": "#cookiescript_accept"
            }
          },
          "showingMatcher": {
            "type": "css",
            "target": {
              "selector": "#cookiescript_accept",
              "displayFilter": true
            }
          }
        }
      ],
      "methods": [
        {
          "name": "HIDE_CMP",
          "action": {
            "type": "hide",
            "target": {
              "selector": "#cookiescript_injected_wrapper, #cookiescript_injected"
            }
          }
        },
        {
          "name": "SAVE_CONSENT",
          "action": {
            "type": "click",
            "target": {
              "selector": "#cookiescript_reject"
            }
          }
        }
      ]
    }
}