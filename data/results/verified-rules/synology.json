{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "Synology": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".syno_cookie_element,.scb_dialog_content"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".syno_cookie_element,.scb_dialog_content"
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": ".syno_cookie_element"
                            }
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": ".scb_dialog_content"
                            }
                        }
                    ]
                },
                "name": "HIDE_CMP"
            },
            {
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": ".btn_option"
                    },
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": ".btn_option"
                        }
                    },
                    "falseAction": {
                        "type": "wait",
                        "waitTime": 200
                    }
                },
                "name": "OPEN_OPTIONS"
            },
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "input[data-key='performance']"
                            },
                            "retries": 10,
                            "waitTime": 250
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input[data-key='performance']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "label[for='performance']"
                                        }
                                    },
                                    "type": "B"
                                },
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input[data-key='functionality']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "label[for='functionality']"
                                        }
                                    },
                                    "type": "A"
                                },
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input[data-key='targeting']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "label[for='targeting']"
                                        }
                                    },
                                    "type": "F"
                                }
                            ]
                        }
                    ]
                },
                "name": "DO_CONSENT"
            },
            {
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".scb_btn_save"
                    }
                },
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}