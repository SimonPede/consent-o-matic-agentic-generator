{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "Cookie-Script": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookiescript_injected"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookiescript_buttons",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#cookiescript_description"
                            },
                            "retries": 15,
                            "waitTime": 600
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cookiescript_checkboxs"
                            }
                        }
                    ]
                },
                "name": "HIDE_CMP"
            },
            {
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cookiescript_category_functionality"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "label[for='cookiescript_category_functionality']"
                                }
                            },
                            "type": "A"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cookiescript_category_performance"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "label[for='cookiescript_category_performance']"
                                }
                            },
                            "type": "B"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cookiescript_category_targeting"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "label[for='cookiescript_category_targeting']"
                                }
                            },
                            "type": "F"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cookiescript_category_unclassified"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "label[for='cookiescript_category_unclassified']"
                                }
                            },
                            "type": "X"
                        }
                    ]
                },
                "name": "DO_CONSENT"
            },
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#cookiescript_save",
                                "displayFilter": true
                            },
                            "retries": 15,
                            "waitTime": 250
                        },
                        {
                            "type": "wait",
                            "waitTime": 250
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "#cookiescript_save"
                            }
                        }
                    ]
                },
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            },
            {
                "name": "OPEN_OPTIONS"
            }
        ]
    }
}