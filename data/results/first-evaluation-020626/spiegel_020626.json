            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "wait",
                            "waitTime": 500
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "button.sp_choice_type_SAVE_AND_EXIT"
                            }
                        }
                    ]
                }
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
