                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Accept"
                                }
                            },
                            "falseAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Drittanbieter Inhalte aus sozialen Netzwerken"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Reject"
                                }
                            }
