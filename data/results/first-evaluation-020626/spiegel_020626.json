{
    "Sourcepoint": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class*='message-container']"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class*='message-container']",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": "[aria-label='Preferences']"
                            }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": ".tcfv2-stack"
                            },
                            "retries": 15,
                            "waitTime": 300
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "D",
                            "trueAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Store and/or access information"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Accept"
                                }
                            },
                            "falseAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Store and/or access information"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Reject"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "trueAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Personalisierte Werbung"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Accept"
                                }
                            },
                            "falseAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Personalisierte Werbung"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Reject"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "trueAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Politische Werbung"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
                                    "textFilter": "Accept"
                                }
                            },
                            "falseAction": {
                                "type": "click",
                                "parent": {
                                    "selector": ".stack-row",
                                    "childFilter": {
                                        "target": {
                                            "selector": "h2",
                                            "textFilter": "Politische Werbung"
                                        }
                                    }
                                },
                                "target": {
                                    "selector": "button",
